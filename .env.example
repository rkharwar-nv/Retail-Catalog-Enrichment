# NVIDIA NGC API key (https://build.nvidia.com/)
NGC_API_KEY=

# HuggingFace token for FLUX model (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Optional Exa API key for product web insights (https://dashboard.exa.ai/)
EXA_API_KEY=

# Single-call fashion enrichment (docs/FASHION_SINGLE_CALL.md). Only the model is
# required, and the credential falls back to NGC_API_KEY. Set these to point the
# module at a locally hosted or third-party OpenAI-compatible VLM.
FASHION_VLM_MODEL=
FASHION_VLM_URL=
FASHION_VLM_API_KEY=
